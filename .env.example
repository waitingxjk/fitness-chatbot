# Existing OPENAI_API_BASE is also accepted. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# For endpoints whose example uses client.responses.create, enable this and
# use its exact deployment name (including any deployment suffix).
OPENAI_USE_RESPONSES_API=false
# Optional; only set for models supporting reasoning effort.
# OPENAI_REASONING_EFFORT=low
HOST=127.0.0.1
PORT=8000
CHAT_TIMEOUT_SECONDS=90
# DATABASE_URL is created in ignored .env.mysql by scripts/setup_mysql.py.

# User isolation is always active. Authentication is opt-in.
AUTH_ENABLED=false
# Compatibility lookup for requests without X-User-Id; not a client-selected account ID.
DEFAULT_USER_ID=local-user
# Optional catalog thumbnails; development defaults to adjacent flutter-init assets.
# EXERCISE_MEDIA_DIRECTORY=/path/to/assets/exercises/images
