# Existing OPENAI_API_BASE is also accepted. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional; only set for models supporting reasoning effort.
# OPENAI_REASONING_EFFORT=low
HOST=127.0.0.1
PORT=8000
CHAT_TIMEOUT_SECONDS=90
# DATABASE_URL is created in ignored .env.mysql by scripts/setup_mysql.py.
